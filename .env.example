# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional Google Cloud YouTube Data API v3 key for searching individual gymnastics skill tutorials.
# Enable "YouTube Data API v3" in Google Cloud Console, generate an API Key under Credentials, and provide it here.
YOUTUBE_API_KEY=

# ---- SolyntaFlow (GymTrack's own company there) ----
# When SOLYNTAFLOW_TOKEN is set, every Contact Us enquiry becomes a Customer
# Service ticket on that company, and fee reminders go out as WhatsApp
# messages sent by SolyntaFlow (billed to that company's wallet). This replaces
# the direct WhatsApp settings below. Use the API token of a user of that company.
SOLYNTAFLOW_TOKEN=
SOLYNTAFLOW_API_URL=https://solyntaflow.uc.r.appspot.com
# Approved WhatsApp template used for fee reminders (leave blank to send plain text only).
SOLYNTAFLOW_FEE_TEMPLATE=gymtrack_fee_reminder_v1

# ---- Contact form email (Contact Us page and the home page form) ----
# Enquiries are always saved. They are emailed only when ALL of these are set.
# CONTACT_TO is the mailbox that receives them. It is never sent to the browser.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# ---- WhatsApp fee reminders (WhatsApp Business Cloud API from Meta) ----
# Fee reminders are only sent when the token and phone number id are set.
# WHATSAPP_TEMPLATE_NAME: an approved message template with three text
# variables (gymnast name, club name, message). Required to message people who
# have not written to the number in the last 24 hours.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ---- Google Drive storage for videos and documents ----
# Set the folder id to keep every upload in that one Drive folder. The folder is
# not shared publicly. GymTrack serves each file itself, after checking who is
# asking. Private skill videos stay private. A public Connect video is public
# only inside GymTrack, never as a public Drive link.
#
# Preferred sign-in, including for the personal My Drive folder
# 1YwIkSA6-1DZb19r-WMCEQZyd2T4W0oUW: OAuth as the Google account that owns the
# folder. Set all three variables, or none of them. Create a Desktop OAuth
# client in GCP project solyntaflow, publish the consent screen (External) to
# In production, then run `npm run drive:auth`. Steps are in README.md.
# Optional for that one-time command only: GOOGLE_OAUTH_LOGIN_HINT (the owner's
# Google address, so the account chooser opens on the right account).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# Used only when the three OAuth variables above are all unset.
# GOOGLE_SERVICE_ACCOUNT_JSON is the key file's contents. On Cloud Run, leave
# it unset to use the service account the service runs as. A service account
# has no storage of its own, so this path only works with a Shared Drive.
GYMTRACK_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Where uploads go when Drive is not set ----
# Defaults to data/uploads next to the database file. On a host whose disk is
# wiped on every deploy (Cloud Run, Vercel), point this at a persistent volume.
GYMTRACK_UPLOADS=
